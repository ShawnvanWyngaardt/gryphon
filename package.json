{
  "name": "gryphon-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p packages/gryphon-designmd --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p packages/gryphon-designmd/tsconfig.build.json",
    "gryphon": "node packages/gryphon-designmd/dist/src/cli/main.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@google/design.md": "0.4.0",
    "@types/culori": "4.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "ajv": "8.20.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@google/design.md": {
      "zod": "4.6.7"
    },
    "postcss": "8.5.32"
  }
}
